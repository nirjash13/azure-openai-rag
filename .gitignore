###############################################################################
# Azure OpenAI RAG — .gitignore
# Covers: C# / .NET 8, Visual Studio / VS Code / Rider, Docker, Azure, secrets
###############################################################################

# ── Planning & design docs (kept outside version control) ───────────────────
docs/

# ── .NET / C# build outputs ──────────────────────────────────────────────────
## Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

## NuGet packages
*.nupkg
*.snupkg
.nuget/packages/
nuget.config  # keep per-repo configs only if committed intentionally
**/[Pp]ackages/
# NuGet cache (per-repo restore artifacts)
project.lock.json
project.fragment.lock.json
artifacts/

# ── Visual Studio ─────────────────────────────────────────────────────────────
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider
.idea/
*.sln.iml

# ── Test results & coverage ──────────────────────────────────────────────────
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*/
*.opencover.xml
*.cobertura.xml

# ── Publish output ───────────────────────────────────────────────────────────
**/publish/
**/PublishProfiles/

# ── Entity Framework / EF Core ───────────────────────────────────────────────
# Uncomment if you don't commit migrations
# **/Migrations/

# ── Secrets & environment ────────────────────────────────────────────────────
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
secrets.json
**/*secrets*.json

# Azure credentials / service principal
*.publishsettings
*.azurePubxml
*.azurewebsites.net.publishsettings

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml
.dockerignore   # usually committed, but ignore local overrides
**/.docker/

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Windows ──────────────────────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*~.nib
.agents/
